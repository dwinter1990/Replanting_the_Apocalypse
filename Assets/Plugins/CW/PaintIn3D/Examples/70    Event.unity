--- !u!1001 &545925767
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 114862740261869284, guid: f43c82fa79085354ba883fd6d09728bc, type: 3}
      propertyPath: m_Text
      value: 'This shows you how to detect when a specific color has been read, and
        trigger an action from it. This is done using the <color=#0FF>CwReadColorEvent</color>
        component, which can be added alongside the <color=#0FF>CwReadColor</color>
        component. When you read a color within the <color=#0FF>Threshold</color>
        distance of your specified <color=#0FF>Color</color>, it will trigger the
        <color=#0FF>OnColor</color> event, which can be used to perform any action.

        Swipe
        / Click + Drag = Read'
      objectReference: {fileID: 0}
